🤖 LLM‑клиент (NeuralDeep)
Copilot должен реализовать:

Chat Completions
python
from openai import OpenAI
import os

client = OpenAI(
    api_key=os.getenv("NEURALDEEP_API_KEY"),
    base_url=os.getenv("NEURALDEEP_BASE_URL")
)

async def nd_chat(messages: list[dict]):
    response = client.chat.completions.create(
        model=os.getenv("NEURALDEEP_MODEL"),
        messages=messages,
        temperature=0.2,
        max_tokens=1200
    )
    return response.choices[0].message.content
Embeddings
python
async def nd_embed(texts: list[str]):
    response = client.embeddings.create(
        model=os.getenv("NEURALDEEP_EMBED_MODEL"),
        input=texts
    )
    return [e.embedding for e in response.data]
